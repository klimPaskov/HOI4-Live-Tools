{
  "version": 1,
  "id": "hoi4-campaign-fair-meta-v1",
  "default_mode": "fair",
  "showcase_mode": "fair",
  "modes": [
    "fair",
    "meta"
  ],
  "prohibited_in_both": [
    "console",
    "debug_launch",
    "eval",
    "fire_event",
    "save_editing",
    "memory_writes",
    "hidden_enemy_intelligence",
    "reload_to_undo"
  ],
  "fair_prohibited": [
    "space_marines",
    "naval_invasion_exploit_spam",
    "paratrooper_exploit_spam",
    "exploit_templates",
    "ai_baiting",
    "engine_bug_exploits"
  ],
  "fair_permitted_examples": [
    "encirclements",
    "concentrated_breakthroughs",
    "air_superiority_before_offensives",
    "defensive_lines",
    "combined_arms",
    "sound_economy"
  ],
  "meta_scope": "Competitive metas and exploits through reviewed ordinary player actions; all universal prohibitions still apply.",
  "enforcement_limits": "Deterministic FAIR review can validate normal land orders against fresh own-army IDs, public target IDs, complete template composition and bounded order history. It cannot infer strategic intent or prove absence of every engine exploit. Unsupported actions require a separate reviewed adapter; raw input remains unavailable. No live acceptance is implied. There is no live semantic review provider; deterministic checks do not establish intent.",
  "evidence_max_age_seconds": 5,
  "review_sources": [
    "own_country_telemetry",
    "visible_screen",
    "verified_read_only_memory"
  ],
  "fair_review_requirements": [
    "ordinary_player_action",
    "player_visible_state_only",
    "reviewed_action_scope"
  ],
  "resume_review_requirements": [
    "interruption_resume_without_rollback",
    "save_content_hash_verified",
    "campaign_identity_verified",
    "latest_progress_verified"
  ],
