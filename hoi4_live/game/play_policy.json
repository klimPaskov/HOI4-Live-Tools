  "allowed_launch_arguments": [
    "-skiplauncher",
    "-nolauncher",
    "-windowed"
  ],
  "argument_denials": [
    {
      "tools": [
        "*"
      ],
      "field": "mode",
      "operator": "equals",
      "value": "test",
      "reason": "campaign_test_mode_escape"
    },
    {
      "tools": [
        "*"
      ],
      "field": "raw",
      "operator": "truthy",
      "reason": "unfiltered_state"
    },
    {
      "tools": [
        "*"
      ],
      "field": "save",
      "operator": "equals",
      "value": "fresh",
      "reason": "observation_must_not_write_save"
    },
    {
      "tools": [
        "hoi4_launch"
      ],
      "field": "debug",
      "operator": "truthy",
      "reason": "debug_launch"
    },
    {
      "tools": [
        "hoi4_new_game"
      ],
      "field": "tag",
      "operator": "truthy",
      "reason": "console_tag_switch"
    },
    {
      "tools": [
        "hoi4_save_query"
      ],
      "field": "query",
      "operator": "not_equals",
      "value": "info",
      "default": "info",
      "reason": "hidden_enemy_intelligence"
    },
    {
      "tools": [
        "hoi4_logs"
      ],
      "field": "log",
      "operator": "in",
      "value": [
        "game",
        "text"
      ],
      "reason": "unfiltered_gameplay_logs"
    },
    {
      "tools": [
        "hoi4_briefing"
      ],
      "field": "log_notes",
      "operator": "truthy",
      "reason": "unfiltered_gameplay_logs"
    },
    {
      "tools": [
        "hoi4_state"
      ],
      "field": "sections",
      "operator": "contains",
      "value": "script",
      "reason": "script_state"
    }
  ],
  "showcase_modes": {
    "GER": "fair",
    "CHI": "fair",
    "POL": "meta"
  },
  "fair_land_rules": {
    "actions": [
      "front",
      "offensive",
      "spearhead",
      "attack",
      "batch",
      "execute"
    ],
    "max_armies_per_call": 40,
    "max_distinct_targets_per_army_per_day": 4,
    "min_line_battalions": 1,
    "max_line_battalions": 25,
    "max_leg_infantry_or_cavalry_with_line_armor": 0,
    "line_roles": [
      "leg_infantry",
      "cavalry",
      "armor",
      "motorized",
      "mechanized",
      "artillery",
      "anti_tank",
      "anti_air"
    ],
    "notes": "Normal support companies are allowed. These numerical house limits bound target churn and prohibited template mixtures; they are not an AI-intent or universal exploit detector. Naval/paratrooper operations need a separate reviewed adapter."
  }
}
